{
  "$id": "https://cvs-system.local/schemas/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            },
            "recovery": {
              "via": "email"
            }
          }
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "description": "Full name of the user"
        }
      },
      "required": [
        "email",
        "fullName"
      ]
    }
  },
  "required": [
    "traits"
  ],
  "additionalProperties": false
}
