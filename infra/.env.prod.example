# Production domains (DNS A/AAAA records should point to this server)
APP_DOMAIN=cvssystem.io
AUTH_DOMAIN=auth.cvssystem.io

# PostgreSQL
POSTGRES_USER=cvs_system_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_HEX_SECRET
POSTGRES_DB=cvs_system
KRATOS_DSN="postgres://cvs_system_user:REPLACE_WITH_STRONG_HEX_SECRET@postgres:5432/kratos?sslmode=disable&connect_timeout=5"

# Kratos: generate distinct secrets, e.g. with `openssl rand -hex 32`
KRATOS_COOKIE_SECRET=REPLACE_WITH_A_DISTINCT_64_CHARACTER_HEX_SECRET
KRATOS_CIPHER_SECRET=REPLACE_WITH_A_DISTINCT_64_CHARACTER_HEX_SECRET

# MinIO: use credentials distinct from the application user
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ROOT_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_HEX_SECRET
MINIO_BUCKET=cvs-system
MINIO_APP_USER=EXAMPLE_USER
MINIO_APP_PASSWORD=REPLACE_WITH_ANOTHER_STRONG_HEX_SECRET

FILE_ENCRYPTION_KEY=REPLACE_WITH_A_DISTINCT_64_HEX_CHARS_SECRET
