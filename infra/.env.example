# PostgreSQL
POSTGRES_USER=cvs_system
POSTGRES_PASSWORD=cvs_system_dev_password
POSTGRES_DB=cvs_system
POSTGRES_PORT=5432

# Nuxt
NUXT_PORT=3000

# Kratos
KRATOS_PUBLIC_PORT=4433
KRATOS_ADMIN_PORT=4434

KRATOS_DSN="postgres://cvs_system:cvs_system_dev_password@postgres:5432/kratos?sslmode=disable&connect_timeout=5"

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9002

MINIO_BUCKET=cvs-system

S3_PUBLIC_ENDPOINT=http://localhost:9002

# Secrets
KRATOS_COOKIE_SECRET=kcks_REPLACE_WITH_A_DISTINCT_64_CHARACTER_HEX_SECRET
KRATOS_CIPHER_SECRET=kcps_REPLACE_WITH_A_DISTINCT_64_CHARACTER_HEX_SECRET
MINIO_APP_USER=EXAMPLE_USER
MINIO_APP_PASSWORD=REPLACE_WITH_PASSWORD_FOR_MINIO_APP_USER
